<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.cfuentes</groupId>
    <artifactId>automation_excersise</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versiones -->
        <selenium.version>4.35.0</selenium.version>
        <cucumber.version>7.27.2</cucumber.version>
        <junit.jupiter.version>5.13.4</junit.jupiter.version>
        <junit.platform.version>1.13.4</junit.platform.version>
    </properties>

    <!-- ============================= -->
    <!-- DEPENDENCIAS                  -->
    <!-- ============================= -->

    <dependencies>

        <!--
            SELENIUM
            Permite automatizar el navegador.
        -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>


        <!--
            CUCUMBER JAVA
            Permite utilizar las anotaciones de Cucumber:
            @Given
            @When
            @Then
            @Before
            @After
        -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>


        <!--
            CUCUMBER + JUNIT PLATFORM

            Permite ejecutar Cucumber utilizando
            la plataforma de JUnit 5.
        -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>


        <!--
            JUNIT 5 / JUPITER

            IMPORTANTE:
            Esta dependencia contiene Assertions.

            Por ejemplo:

            assertEquals()
            assertTrue()
            assertFalse()
            assertAll()

            y permite:

            import static org.junit.jupiter.api.Assertions.*;
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>


        <!--
            JUNIT PLATFORM SUITE

            Se utiliza para crear el Runner de Cucumber
            con @Suite.
        -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <version>${junit.platform.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-cucumber7-jvm</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>


    <!-- ============================= -->
    <!-- CONFIGURACIÓN DE MAVEN        -->
    <!-- ============================= -->

    <build>

        <plugins>

            <!--
                COMPILADOR DE MAVEN

                Indica que el proyecto utiliza Java 17.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.0</version>

                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>

            </plugin>


            <!--
                MAVEN SUREFIRE

                Es el plugin encargado de ejecutar
                los tests cuando hacemos:

                mvn test
                mvn clean test
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.3</version>
            </plugin>

            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>2.18.0</version>
            </plugin>

        </plugins>

    </build>

</project>