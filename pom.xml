<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.entregable</groupId>
    <artifactId>automation_excersise</artifactId>
    <version>1.0.0</version>
    <name>automation_excersise</name>
    <description>Framework base de automatización E2E para Automation Exercise</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Versiones -->
        <selenium.version>4.35.0</selenium.version>
        <cucumber.version>7.14.0</cucumber.version>
        <junit.jupiter.version>5.11.4</junit.jupiter.version>
        <junit.platform.version>1.11.4</junit.platform.version>

        <!-- Allure  -->
        <allure.version>2.29.1</allure.version>
        <aspectj.version>1.9.22</aspectj.version>
        <surefire.version>3.5.2</surefire.version>
        <allure.maven.plugin.version>2.12.0</allure.maven.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-bom</artifactId>
                <version>${allure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- ============================= -->
    <!-- DEPENDENCIAS                  -->
    <!-- ============================= -->

    <dependencies>

        <!--
            SELENIUM
            Permite automatizar el navegador.
        -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>


        <!--
            CUCUMBER JAVA
            Permite utilizar las anotaciones de Cucumber:
            @Given
            @When
            @Then
            @Before
            @After
        -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>


        <!--
            CUCUMBER + JUNIT PLATFORM

            Permite ejecutar Cucumber utilizando
            la plataforma de JUnit 5.
        -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>


        <!--
            JUNIT 5 / JUPITER

            IMPORTANTE:
            Esta dependencia contiene Assertions.

            Por ejemplo:

            assertEquals()
            assertTrue()
            assertFalse()
            assertAll()

            y permite:

            import static org.junit.jupiter.api.Assertions.*;
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.jupiter.version}</version>
            <scope>test</scope>
        </dependency>


        <!--
            JUNIT PLATFORM SUITE

            Se utiliza para crear el Runner de Cucumber
            con @Suite.
        -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <version>${junit.platform.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-cucumber7-jvm</artifactId>
            <version>${allure.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <repositories>
        <repository>
            <id>allure-repo</id>
            <url>https://repo.qameta.io/repository/maven-public/</url>
        </repository>
    </repositories>


    <!-- ============================= -->
    <!-- CONFIGURACIÓN DE MAVEN        -->
    <!-- ============================= -->

    <build>

        <plugins>

            <!--
                COMPILADOR DE MAVEN

                Indica que el proyecto utiliza Java 17.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>

                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>

            </plugin>


            <!--
                MAVEN SUREFIRE

                Es el plugin encargado de ejecutar
                los tests cuando hacemos:

                mvn test
                mvn clean test
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <argLine>
                        -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"
                    </argLine>
                    <systemPropertyVariables>
                        <property>
                            <name>allure.results.directory</name>
                            <value>${project.basedir}/target/allure-results</value>
                        </property>
                        <property>
                            <name>app.slow.ms</name>
                            <value>0</value>
                        </property>
                    </systemPropertyVariables>
                    <!-- Se habilita cuando se agreguen features Gherkin. -->
                    <excludes>
                        <exclude>**/TestRunner.java</exclude>
                    </excludes>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.aspectj</groupId>
                        <artifactId>aspectjweaver</artifactId>
                        <version>${aspectj.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>${allure.maven.plugin.version}</version>
                <configuration>
                    <reportVersion>2.29.0</reportVersion>
                    <resultsDirectory>${project.basedir}/target/allure-results</resultsDirectory>
                    <reportDirectory>${project.basedir}/target/site/allure</reportDirectory>
                </configuration>
            </plugin>

        </plugins>

    </build>

</project>
